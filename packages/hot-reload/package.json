{
  "name": "@xenon-ssg/hot-reload",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Reload a Node app's changed modules in place, without restarting the process.",
  "sideEffects": [
    "./src/hooks.ts",
    "./dist/hooks.js"
  ],
  "exports": {
    ".": {
      "@xenon-ssg/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "@xenon-ssg/source": "./src/hooks.ts",
      "types": "./dist/hooks.d.ts",
      "default": "./dist/hooks.js"
    },
    "./reload": {
      "@xenon-ssg/source": "./src/reload.ts",
      "types": "./dist/reload.d.ts",
      "default": "./dist/reload.js"
    },
    "./supervisor": {
      "@xenon-ssg/source": "./src/supervisor.ts",
      "types": "./dist/supervisor.d.ts",
      "default": "./dist/supervisor.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b tsconfig.package.json",
    "clean": "tsc -b tsconfig.package.json --clean && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "pnpm run clean && tsc -b tsconfig.package.json --sourceMap false --declarationMap false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:tsc": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaro-cuesta/alvaro.cuesta.dev.git",
    "directory": "packages/hot-reload"
  },
  "keywords": [
    "xenon",
    "hot-reload",
    "hmr",
    "dev-server",
    "node"
  ],
  "author": "Álvaro Cuesta <alvaro-cuesta@GitHub>",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/alvaro-cuesta/alvaro.cuesta.dev/issues"
  },
  "homepage": "https://github.com/alvaro-cuesta/alvaro.cuesta.dev/tree/main/packages/hot-reload#readme",
  "peerDependencies": {
    "@types/node": ">=26"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
