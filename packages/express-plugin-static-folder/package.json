{
  "name": "@xenon-ssg/express-plugin-static-folder",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Xenon SSG Express plugin that serves a folder of static files.",
  "sideEffects": false,
  "exports": {
    ".": {
      "@xenon-ssg/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b tsconfig.package.json",
    "clean": "tsc -b tsconfig.package.json --clean && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "pnpm run clean && tsc -b tsconfig.package.json --sourceMap false --declarationMap false",
    "lint:tsc": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaro-cuesta/alvaro.cuesta.dev.git",
    "directory": "packages/express-plugin-static-folder"
  },
  "keywords": [
    "xenon",
    "ssg",
    "static-site-generator",
    "express",
    "xenon-ssg-express-plugin",
    "static"
  ],
  "author": "Álvaro Cuesta <alvaro-cuesta@GitHub>",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/alvaro-cuesta/alvaro.cuesta.dev/issues"
  },
  "homepage": "https://github.com/alvaro-cuesta/alvaro.cuesta.dev/tree/master/packages/express-plugin-static-folder#readme",
  "peerDependencies": {
    "@xenon-ssg/express": "workspace:^",
    "express": "catalog:"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@xenon-ssg/express": "workspace:*",
    "express": "catalog:",
    "typescript": "catalog:"
  }
}
