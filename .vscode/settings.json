{
  // The workspace's TypeScript 7, through its extension (see
  // `extensions.json`): VS Code's own only runs TypeScript 6.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript",
  // So "Select Version" offers it (as "Use Custom Version"): its workspace
  // version is only ever `@typescript/native-preview`. Picking it is needed
  // once, as the extension won't run a workspace binary until then.
  "js/ts.tsdk.additionalLocations": ["./node_modules/typescript"],
  // For node.config.json's schema.
  "json.schemaDownload.trustedDomains": {
    "https://nodejs.org/dist/": true
  }
}
