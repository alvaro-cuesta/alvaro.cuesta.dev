{
  "name": "alvaro.cuesta.dev",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Álvaro Cuesta's personal website.",
  "imports": {
    "#components/*": {
      "source": "./src/components/*.tsx",
      "default": "./dist/src/components/*.js",
      "types": "./dist/src/components/*.d.ts"
    }
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--conditions=source tsx --tsconfig ../tsconfig.base.json --import ./src/mdx/mdxNodeLoaderRegister.mjs ./bin/build.ts",
    "build:serve": "serve ./dist",
    "dev": "cross-env NODE_ENV=development NODE_OPTIONS=--conditions=source tsx watch --tsconfig ../tsconfig.base.json --import ./src/mdx/mdxNodeLoaderRegister.mjs ./bin/dev.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:tsc": "tsc -b ../tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaro-cuesta/alvaro.cuesta.dev.git"
  },
  "author": "Álvaro Cuesta <alvaro-cuesta@GitHub>",
  "bugs": {
    "url": "https://github.com/alvaro-cuesta/alvaro.cuesta.dev/issues"
  },
  "homepage": "https://github.com/alvaro-cuesta/alvaro.cuesta.dev#readme",
  "dependencies": {
    "@mdx-js/node-loader": "^3.0.1",
    "@picocss/pico": "^2.0.6",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@wooorm/starry-night": "^3.4.0",
    "classnames": "^2.5.1",
    "estree-walker": "^3.0.3",
    "fontawesome-free": "^1.0.4",
    "html-to-text": "^9.0.5",
    "path-to-regexp": "^8.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recma-mdx-is-mdx-component": "^2.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.0",
    "rehype-shift-heading": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-starry-night": "^2.1.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "temporal-polyfill": "catalog:",
    "tldts": "^7.0.28",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "xenon-ssg": "workspace:*",
    "xenon-ssg-express": "workspace:*",
    "xmlbuilder2": "catalog:"
  },
  "devDependencies": {
    "@mdx-js/typescript-plugin": "^0.1.4",
    "@types/estree": "^1.0.8",
    "@types/html-to-text": "^9.0.4",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/unist": "^3.0.3",
    "cross-env": "^10.1.0",
    "serve": "^14.2.4",
    "tsx": "^4.23.15",
    "vitest": "catalog:"
  }
}
