{
  "name": "xenon-ssg",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "A dead simple React Static-Site Generator.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./render": {
      "source": "./src/render.ts",
      "default": "./dist/render.js",
      "types": "./dist/render.d.ts"
    },
    "./url": {
      "source": "./src/url.ts",
      "default": "./dist/url.js",
      "types": "./dist/url.d.ts"
    },
    "./promise": {
      "source": "./src/promise.ts",
      "default": "./dist/promise.js",
      "types": "./dist/promise.d.ts"
    },
    "./watch": {
      "source": "./src/watch.ts",
      "default": "./dist/watch.js",
      "types": "./dist/watch.d.ts"
    },
    "./middleware": {
      "source": "./src/middleware.tsx",
      "default": "./dist/middleware.js",
      "types": "./dist/middleware.d.ts"
    },
    "./generate/Link": {
      "source": "./src/generate/Link.tsx",
      "default": "./dist/generate/Link.js",
      "types": "./dist/generate/Link.d.ts"
    },
    "./generate/generate": {
      "source": "./src/generate/generate.tsx",
      "default": "./dist/generate/generate.js",
      "types": "./dist/generate/generate.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaro-cuesta/xenon-ssg.git"
  },
  "keywords": [
    "xenon",
    "ssg",
    "static-site-generator",
    "static",
    "react"
  ],
  "author": "Álvaro Cuesta <alvaro-cuesta@GitHub>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alvaro-cuesta/xenon-ssg/issues"
  },
  "homepage": "https://github.com/alvaro-cuesta/xenon-ssg#readme",
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "type-fest": "catalog:",
    "vitest": "catalog:"
  }
}
