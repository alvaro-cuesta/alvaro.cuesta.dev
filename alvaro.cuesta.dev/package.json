{
  "name": "alvaro.cuesta.dev",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Álvaro Cuesta's personal website.",
  "sideEffects": true,
  "imports": {
    "#components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "build": "NODE_ENV=production NODE_OPTIONS=--conditions=@xenon-ssg/source tsx --tsconfig ../tsconfig.base.json --import ./src/mdx/mdxNodeLoaderRegister.mts ./bin/build.ts",
    "build:serve": "serve ./dist",
    "dev": "NODE_ENV=development NODE_OPTIONS=--conditions=@xenon-ssg/source tsx watch --include ./src/mdx --tsconfig ../tsconfig.base.json --import ./src/mdx/mdxNodeLoaderRegister.mts ./bin/dev.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:tsc": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaro-cuesta/alvaro.cuesta.dev.git"
  },
  "author": "Álvaro Cuesta <alvaro-cuesta@GitHub>",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/alvaro-cuesta/alvaro.cuesta.dev/issues"
  },
  "homepage": "https://github.com/alvaro-cuesta/alvaro.cuesta.dev#readme",
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@picocss/pico": "^2.0.6",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@wooorm/starry-night": "^3.4.0",
    "@xenon-ssg/core": "workspace:*",
    "@xenon-ssg/express": "workspace:*",
    "classnames": "^2.5.1",
    "estree-walker": "^3.0.3",
    "fontawesome-free": "^1.0.4",
    "hast-util-to-string": "^3.0.1",
    "html-to-text": "^9.0.5",
    "levenshtein-edit-distance": "^3.0.1",
    "path-to-regexp": "^8.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recma-mdx-is-mdx-component": "^2.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.0",
    "rehype-shift-heading": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "source-map": "^0.7.6",
    "tldts": "^7.0.28",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vfile-reporter": "^8.1.1",
    "xmlbuilder2": "catalog:"
  },
  "devDependencies": {
    "@mdx-js/typescript-plugin": "^0.1.4",
    "@types/estree": "^1.0.8",
    "@types/hast": "^3.0.4",
    "@types/html-to-text": "^9.0.4",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/unist": "^3.0.3",
    "serve": "^14.2.4",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
