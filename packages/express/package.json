{
  "name": "@xenon-ssg/express",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Express layer for Xenon SSG — a dead simple React Static-Site Generator.",
  "sideEffects": false,
  "exports": {
    ".": {
      "@xenon-ssg/source": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "@xenon-ssg/source": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./cache": {
      "@xenon-ssg/source": "./src/cache.ts",
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./cache-busting": {
      "@xenon-ssg/source": "./src/cache-busting.ts",
      "types": "./dist/cache-busting.d.ts",
      "default": "./dist/cache-busting.js"
    },
    "./dev": {
      "@xenon-ssg/source": "./src/dev.ts",
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.js"
    },
    "./plugin": {
      "@xenon-ssg/source": "./src/plugin.tsx",
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b tsconfig.package.json",
    "clean": "tsc -b tsconfig.package.json --clean && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "pnpm run clean && tsc -b tsconfig.package.json --sourceMap false --declarationMap false",
    "lint:tsc": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaro-cuesta/alvaro.cuesta.dev.git",
    "directory": "packages/express"
  },
  "keywords": [
    "xenon",
    "ssg",
    "static-site-generator",
    "static",
    "react",
    "express"
  ],
  "author": "Álvaro Cuesta <alvaro-cuesta@GitHub>",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/alvaro-cuesta/alvaro.cuesta.dev/issues"
  },
  "homepage": "https://github.com/alvaro-cuesta/alvaro.cuesta.dev/tree/master/packages/express#readme",
  "dependencies": {
    "@types/express": "catalog:",
    "express": "catalog:",
    "morgan": "^1.10.0",
    "type-fest": "catalog:"
  },
  "peerDependencies": {
    "@xenon-ssg/core": "workspace:^",
    "react": "catalog:",
    "@types/node": ">=26",
    "@types/react": "catalog:"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/morgan": "^1.9.9",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@xenon-ssg/core": "workspace:*",
    "react": "catalog:",
    "typescript": "catalog:"
  }
}
