{
  // Not `../tsconfig.package.json`: the site runs from its sources (through
  // tsx) and nothing references it, so it only needs checking.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // For `checkMdx`: an .mdx file is checked as the JavaScript it maps to.
    "allowJs": true,
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.package.tsbuildinfo",
    "types": ["node", "mdx", "@xenon-ssg/import-url/types"]
  },
  // TypeScript in .mdx files: the editor runs it once you allow it, and `tsc`
  // only with `--runExternalCode`. Installed from a commit, as its latest
  // release (0.0.2) fails on any Markdown link: back to a version once one has
  // the fix (remcohaszing/mdx-content-mapper#1). It runs the `node` on the
  // PATH, so an editor started outside a shell needs one there (with fnm, its
  // `aliases/default` folder), or it fails with TS18099.
  // @todo Drop the PATH note once VS Code runs it with its own Node:
  // https://github.com/microsoft/TypeScript/issues/65114
  "contentMappers": [
    {
      "package": "mdx-content-mapper",
      "extensions": [".mdx"],
      "options": {
        "checkMdx": true,
        // The syntax ones the site compiles with (see `mdxCompiler.mts`), so
        // e.g. `$\frac{a}{b}$` is math, not JavaScript expressions.
        "remarkPlugins": ["remark-gfm", "remark-math"]
      }
    }
  ],
  "include": [
    "bin/**/*",
    "src/**/*",
    "blog/**/*",
    "timeline/**/*",
    "config.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    { "path": "../packages/core/tsconfig.package.json" },
    { "path": "../packages/express/tsconfig.package.json" },
    { "path": "../packages/express-plugin-favicon/tsconfig.package.json" },
    { "path": "../packages/express-plugin-feeds/tsconfig.package.json" },
    { "path": "../packages/express-plugin-sitemap/tsconfig.package.json" },
    { "path": "../packages/express-plugin-single-lightningcss/tsconfig.package.json" },
    { "path": "../packages/express-plugin-static-file/tsconfig.package.json" },
    { "path": "../packages/express-plugin-static-folder/tsconfig.package.json" },
    { "path": "../packages/hot-reload/tsconfig.package.json" },
    { "path": "../packages/import-url/tsconfig.package.json" },
    { "path": "../packages/thunks/tsconfig.package.json" }
  ]
}
