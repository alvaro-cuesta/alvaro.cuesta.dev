{
  "extends": "./tsconfig.base.json",
  "include": ["${configDir}/src/**/*"],
  "exclude": [
    "${configDir}/src/**/*.test.ts",
    "${configDir}/src/**/*.test.tsx"
  ],
  "compilerOptions": {
    "composite": true,
    // Only for emitting: it rejects imports into another project, as tests'
    // imports into their package's project (the relative paths differ).
    "rewriteRelativeImportExtensions": true,
    // Exports must spell out their types, so the declarations only change when
    // the public API does, and they can be emitted file by file.
    "isolatedDeclarations": true,
    // For local development: `prepack` builds without them.
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.package.tsbuildinfo"
  }
}
