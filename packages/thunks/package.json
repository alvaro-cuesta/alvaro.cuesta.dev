{
  "name": "@xenon-ssg/thunks",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Values you get later: lazy, shared promises, and cells that can be invalidated.",
  "sideEffects": false,
  "exports": {
    ".": {
      "@xenon-ssg/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b tsconfig.package.json",
    "clean": "tsc -b tsconfig.package.json --clean && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "pnpm run clean && tsc -b tsconfig.package.json --sourceMap false --declarationMap false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:tsc": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaro-cuesta/alvaro.cuesta.dev.git",
    "directory": "packages/thunks"
  },
  "keywords": [
    "xenon",
    "thunk",
    "promise",
    "lazy",
    "cache",
    "invalidation"
  ],
  "author": "Álvaro Cuesta <alvaro-cuesta@GitHub>",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/alvaro-cuesta/alvaro.cuesta.dev/issues"
  },
  "homepage": "https://github.com/alvaro-cuesta/alvaro.cuesta.dev/tree/master/packages/thunks#readme",
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
