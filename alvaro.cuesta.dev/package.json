    "dev": "NODE_ENV=development TSX_TSCONFIG_PATH=../tsconfig.base.json node --conditions=@xenon-ssg/source ./bin/dev.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:tsc": "tsc -b"
