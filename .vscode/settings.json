{
  // TypeScript 6, aliased: TypeScript 7 has no tsserver yet, which the MDX
  // TypeScript plugin needs. Builds use TypeScript 7.
  "js/ts.tsdk.path": "./node_modules/typescript6/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  // For node.config.json's schema.
  "json.schemaDownload.trustedDomains": {
    "https://nodejs.org/dist/": true
  }
}
